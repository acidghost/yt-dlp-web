    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "lit": "3.3.3",
    "missing.css": "1.3.0"
  }
}
